{
  "name": "@mlahr/docusaurus-cloudflare-search",
  "version": "1.0.0",
  "description": "Lunr search index generator for Docusaurus with Cloudflare Workers support",
  "keywords": [
    "docusaurus",
    "search",
    "cloudflare",
    "workers",
    "lunr",
    "index-generator",
    "api"
  ],
  "license": "MIT",
  "repository": "mlahr/docusaurus-cloudflare-search",
  "main": "lib/server/index.js",
  "files": [
    "/src",
    "/lib",
    "/LICENSE",
    "/README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "mlahr",
  "dependencies": {
    "cheerio": "^1.0.0",
    "lunr-languages": "^1.4.0",
    "tslib": "^2.6.3"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "nodejieba": "^2.5.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "nodejieba": {
      "optional": true
    }
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "catalog:",
    "@docusaurus/plugin-content-blog": "catalog:",
    "@docusaurus/plugin-content-docs": "catalog:",
    "@docusaurus/plugin-content-pages": "catalog:",
    "@docusaurus/types": "catalog:",
    "@docusaurus/utils-validation": "catalog:",
    "@types/lunr": "^2.3.3",
    "nodejieba": "^2.5.0 || ^3.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && cp src/lunr.js lib/ && cp src/server/lunr-generator.js lib/server/",
    "dev": "tsc --project tsconfig.json --watch"
  }
}
